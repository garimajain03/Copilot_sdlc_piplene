# Setup Script Template

> Template for generating customer-specific setup.sh (macOS/Linux).
> The Preflight Agent uses this as a reference for generating the actual script.

```bash
#!/usr/bin/env bash
###############################################################################
# setup.sh — SDLC Pipeline Setup for {{COMPANY_NAME}} (macOS/Linux)
#
# Configures:
{{#if TICKET_CONNECTOR}}
#   1. {{PM_SYSTEM}} Connector (Ticket Management)
{{/if}}
{{#if SCM_CONNECTOR}}
#   2. {{SCM_PROVIDER}} Connector (Source Control)
{{/if}}
{{#if DESIGN_CONNECTOR}}
#   3. {{DESIGN_TOOL}} Connector (Design)
{{/if}}
{{#if OBSERVABILITY}}
#   4. Observability Stack
{{/if}}
#
# Usage:
#   chmod +x setup.sh && ./setup.sh
#   ./setup.sh --pipeline-preflight  # Non-interactive validation
#   ./setup.sh --reconfigure         # Force reconfigure
#
# Generated by SDLC Pipeline Preflight Agent
###############################################################################
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── Colors & Helpers ────────────────────────────────────────────────────────

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

info()    { echo -e "${BLUE}ℹ${NC}  $*"; }
success() { echo -e "${GREEN}✓${NC}  $*"; }
warn()    { echo -e "${YELLOW}⚠${NC}  $*"; }
error()   { echo -e "${RED}✗${NC}  $*"; }

read_secret() {
  local prompt="$1" var_name="$2"
  echo -en "${BLUE}→${NC} $prompt: "
  read -rs value; echo ""
  eval "$var_name=\$value"
}

command_exists() { command -v "$1" &>/dev/null; }

# ─── Prerequisite Installation ───────────────────────────────────────────────

info "Checking and installing prerequisites..."

install_if_missing() {
  local cmd="$1" brew_pkg="$2" apt_pkg="$3"
  if ! command_exists "$cmd"; then
    warn "$cmd not found. Installing..."
    if command_exists brew; then
      brew install "$brew_pkg"
    elif command_exists apt-get; then
      sudo apt-get install -y "$apt_pkg"
    elif command_exists dnf; then
      sudo dnf install -y "$apt_pkg"
    else
      error "Cannot install $cmd. Please install it manually."
      exit 1
    fi
  else
    success "$cmd found"
  fi
}

install_if_missing "git" "git" "git"
install_if_missing "node" "node" "nodejs"
install_if_missing "python3" "python3" "python3"
{{#if SCM_CONNECTOR}}
install_if_missing "gh" "gh" "gh"
{{/if}}

{{#if DEFAULT_WORKSPACE}}
# ─── Workspace Configuration ────────────────────────────────────────────────

info "Configuring workspace..."

# ─── Git Submodule Initialization ────────────────────────────────────────────

info "Initializing Git submodules..."

{{#each SUBMODULES}}
if [ ! -d "repos/{{this.name}}" ]; then
  git submodule add {{this.url}} "repos/{{this.name}}"
  success "Added submodule: {{this.name}}"
fi
{{/each}}

git submodule init
git submodule update --init --recursive

# Validate submodule configuration
if git submodule status; then
  success "Submodules initialized successfully"
else
  error "Submodule initialization failed"
  exit 1
fi
{{/if}}

# ─── {{PM_SYSTEM}} Setup ─────────────────────────────────────────────────────
{{TICKET_CONNECTOR_SETUP}}

# ─── {{SCM_PROVIDER}} Setup ──────────────────────────────────────────────────
{{SCM_CONNECTOR_SETUP}}

# ─── Preflight Checks ────────────────────────────────────────────────────────
{{PREFLIGHT_CHECKS}}

{{#if OBSERVABILITY}}
# ─── Observability Stack ─────────────────────────────────────────────────────
info "Setting up observability stack..."

# Install OTel Collector + Prometheus binaries
if ! scripts/install-observability.sh --check >/dev/null 2>&1; then
  info "Downloading telemetry binaries (otelcol-contrib + prometheus)..."
  scripts/install-observability.sh || warn "Observability install failed — telemetry will be degraded"
else
  success "Observability binaries already installed"
fi

# Copy config templates to project observability dir
PROJ_OBS_DIR="${SCRIPT_DIR}/observability"
mkdir -p "$PROJ_OBS_DIR/prometheus"
if [ ! -f "$PROJ_OBS_DIR/otel-collector-config.yml" ]; then
  cp observability/otel-collector-config.yml "$PROJ_OBS_DIR/"
  success "Created otel-collector-config.yml"
fi
if [ ! -f "$PROJ_OBS_DIR/prometheus/prometheus.yml" ]; then
  cp observability/prometheus/prometheus.yml "$PROJ_OBS_DIR/prometheus/"
  success "Created prometheus.yml"
fi
{{/if}}

# ─── Environment Template ────────────────────────────────────────────────────
if [ ! -f ".env" ]; then
  cp .env.template .env
  success "Created .env from template"
fi

# Ensure .env is in .gitignore
if ! grep -qx ".env" .gitignore 2>/dev/null; then
  echo ".env" >> .gitignore
  success "Added .env to .gitignore"
fi

# ─── Validation Checks ──────────────────────────────────────────────────────

info "Running validation checks..."

validation_passed=true
command_exists git || { error "git not available"; validation_passed=false; }
command_exists node || { error "node not available"; validation_passed=false; }
command_exists python3 || { error "python3 not available"; validation_passed=false; }
{{#if DEFAULT_WORKSPACE}}
git submodule status >/dev/null 2>&1 || { error "Submodule validation failed"; validation_passed=false; }
{{/if}}

if [ "$validation_passed" = true ]; then
  success "All validation checks passed"
else
  error "Some validation checks failed"
  exit 1
fi

success "SDLC Pipeline setup complete for {{COMPANY_NAME}}"
```

## Variable Resolution

| Variable | Source |
|----------|--------|
| `COMPANY_NAME` | Onboarding answers → Company |
| `PM_SYSTEM` | Onboarding answers → PM System |
| `SCM_PROVIDER` | Onboarding answers → SCM |
| `DESIGN_TOOL` | Auto-detected or "None" |
| `DEFAULT_WORKSPACE` | True if default workspace structure selected |
| `SUBMODULES` | List of development repositories (name, url) |
| `TICKET_CONNECTOR_SETUP` | PM-system-specific auth and config |
| `SCM_CONNECTOR_SETUP` | SCM-specific auth and config |
| `PREFLIGHT_CHECKS` | Validate all tools and configs |
