# Setup Script Template (Windows PowerShell)

> Template for generating customer-specific setup.ps1.
> The Preflight Agent uses this as a reference for generating the actual script.

```powershell
#Requires -Version 5.1
###############################################################################
# setup.ps1 — SDLC Pipeline Setup for {{COMPANY_NAME}} (Windows)
#
# Configures:
{{#if TICKET_CONNECTOR}}
#   1. {{PM_SYSTEM}} Connector (Ticket Management)
{{/if}}
{{#if SCM_CONNECTOR}}
#   2. {{SCM_PROVIDER}} Connector (Source Control)
{{/if}}
{{#if DESIGN_CONNECTOR}}
#   3. {{DESIGN_TOOL}} Connector (Design)
{{/if}}
{{#if OBSERVABILITY}}
#   4. Observability Stack
{{/if}}
#
# Usage:
#   .\setup.ps1
#   .\setup.ps1 -PipelinePreflight  # Non-interactive validation
#   .\setup.ps1 -Reconfigure        # Force reconfigure
#
# Generated by SDLC Pipeline Preflight Agent
###############################################################################

[CmdletBinding()]
param(
    [switch]$PipelinePreflight,
    [switch]$Reconfigure
)

$ErrorActionPreference = "Stop"
$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path

# ─── Helpers ─────────────────────────────────────────────────────────────────

function Write-Info { param($Message) Write-Host "ℹ  $Message" -ForegroundColor Blue }
function Write-Success { param($Message) Write-Host "✓  $Message" -ForegroundColor Green }
function Write-Warn { param($Message) Write-Host "⚠  $Message" -ForegroundColor Yellow }
function Write-Err { param($Message) Write-Host "✗  $Message" -ForegroundColor Red }

function Test-Command {
    param([string]$Name)
    $null -ne (Get-Command $Name -ErrorAction SilentlyContinue)
}

# ─── Prerequisite Installation ───────────────────────────────────────────────

Write-Info "Checking prerequisites..."

$prerequisites = @(
    @{ Name = "git"; WingetId = "Git.Git"; ChocoName = "git" }
    @{ Name = "node"; WingetId = "OpenJS.NodeJS.LTS"; ChocoName = "nodejs-lts" }
    @{ Name = "python"; WingetId = "Python.Python.3.12"; ChocoName = "python" }
    {{#if SCM_CONNECTOR}}
    @{ Name = "gh"; WingetId = "GitHub.cli"; ChocoName = "gh" }
    {{/if}}
)

foreach ($tool in $prerequisites) {
    if (-not (Test-Command $tool.Name)) {
        Write-Warn "$($tool.Name) not found. Attempting installation..."
        if (Test-Command "winget") {
            winget install --id $tool.WingetId --accept-package-agreements --accept-source-agreements
        } elseif (Test-Command "choco") {
            choco install $tool.ChocoName -y
        } else {
            Write-Err "Cannot install $($tool.Name). Please install winget or chocolatey, or install $($tool.Name) manually."
            exit 1
        }
    } else {
        Write-Success "$($tool.Name) found"
    }
}

# ─── Workspace Configuration ────────────────────────────────────────────────

Write-Info "Configuring workspace..."

{{#if DEFAULT_WORKSPACE}}
# ─── Git Submodule Initialization ────────────────────────────────────────────

Write-Info "Initializing Git submodules..."

# Prevent Windows path-length failures during recursive submodule checkout.
git config --local core.longpaths true | Out-Null
try {
    git config --global core.longpaths true | Out-Null
} catch {
    Write-Warn "Could not set global core.longpaths; continuing with local setting"
}

{{#each SUBMODULES}}
if (-not (Test-Path "repos/{{this.name}}")) {
    $registered = $false
    if (Test-Path ".gitmodules") {
        $registeredPaths = git config --file .gitmodules --get-regexp "submodule\..*\.path" 2>$null
        if ($LASTEXITCODE -eq 0 -and $registeredPaths -match "repos/{{this.name}}") {
            $registered = $true
        }
    }

    if (-not $registered) {
        git submodule add {{this.url}} "repos/{{this.name}}"
        if ($LASTEXITCODE -eq 0) {
            Write-Success "Added submodule: {{this.name}}"
        } else {
            Write-Warn "Could not add submodule {{this.name}}; continuing with existing submodule metadata"
        }
    }
}
{{/each}}

if (Test-Path ".gitmodules") {
    git submodule sync | Out-Null
}

# Use non-recursive update to avoid failing on nested/foreign submodule metadata inside app repos.
git -c core.longpaths=true submodule update --init --jobs 4

# Validate submodule configuration
$submoduleStatus = git submodule status
if ($LASTEXITCODE -eq 0) {
    Write-Success "Submodules initialized successfully"
} else {
    Write-Err "Submodule initialization failed"
    exit 1
}
{{/if}}

# ─── {{PM_SYSTEM}} Setup ─────────────────────────────────────────────────────
{{TICKET_CONNECTOR_SETUP}}

# ─── {{SCM_PROVIDER}} Setup ──────────────────────────────────────────────────
{{SCM_CONNECTOR_SETUP}}

# ─── Preflight Checks ────────────────────────────────────────────────────────
{{PREFLIGHT_CHECKS}}

{{#if OBSERVABILITY}}
# ─── Observability Stack ─────────────────────────────────────────────────────
Write-Info "Setting up observability stack..."

# Resolve observability installer from either generated repo or template repo.
$obsInstallerCandidates = @(
    (Join-Path $ScriptDir ".github\scripts\install-observability.ps1"),
    (Join-Path $ScriptDir "scripts\install-observability.ps1"),
    (Join-Path $ScriptDir "..\..\onboarding-utilities\scripts\install-observability.ps1")
)
$obsInstaller = $obsInstallerCandidates | Where-Object { Test-Path $_ } | Select-Object -First 1
if ($obsInstaller) {
    & $obsInstaller -Check
    if ($LASTEXITCODE -ne 0) {
        Write-Info "Downloading telemetry binaries (otelcol-contrib + prometheus)..."
        & $obsInstaller
        if ($LASTEXITCODE -ne 0) {
            Write-Warn "Observability install failed - telemetry will be degraded"
        }
    } else {
        Write-Success "Observability binaries already installed"
    }
} else {
    Write-Warn "install-observability.ps1 not found; skipping observability binary installation"
}

# Copy config templates
$projObsDir = Join-Path $ScriptDir ".github\observability"
New-Item -ItemType Directory -Force -Path (Join-Path $projObsDir "prometheus") | Out-Null
$obsSourceCandidates = @(
    (Join-Path $ScriptDir ".github\observability"),
    (Join-Path $ScriptDir "observability"),
    (Join-Path $ScriptDir "..\..\onboarding-utilities\observability"),
    (Join-Path $ScriptDir "..\..\observability")
)
$obsSourceDir = $null
foreach ($candidate in $obsSourceCandidates) {
    if (-not (Test-Path $candidate)) {
        continue
    }
    $hasOtelConfig = Test-Path (Join-Path $candidate "otel-collector-config.yml")
    $hasPromConfig = Test-Path (Join-Path $candidate "prometheus\prometheus.yml")
    if ($hasOtelConfig -or $hasPromConfig) {
        $obsSourceDir = $candidate
        break
    }
}
if ($obsSourceDir) {
    $otelSource = Join-Path $obsSourceDir "otel-collector-config.yml"
    $otelTarget = Join-Path $projObsDir "otel-collector-config.yml"
    if (-not (Test-Path $otelTarget) -and (Test-Path $otelSource)) {
        if ([System.StringComparer]::OrdinalIgnoreCase.Equals([System.IO.Path]::GetFullPath($otelSource), [System.IO.Path]::GetFullPath($otelTarget))) {
            Write-Info "otel-collector-config.yml already in place; skipping copy"
        } else {
            Copy-Item $otelSource $otelTarget -ErrorAction SilentlyContinue
            if (Test-Path $otelTarget) {
                Write-Success "Created otel-collector-config.yml"
            }
        }
    }
    $promSource = Join-Path $obsSourceDir "prometheus\prometheus.yml"
    $promTarget = Join-Path $projObsDir "prometheus\prometheus.yml"
    if (-not (Test-Path $promTarget) -and (Test-Path $promSource)) {
        if ([System.StringComparer]::OrdinalIgnoreCase.Equals([System.IO.Path]::GetFullPath($promSource), [System.IO.Path]::GetFullPath($promTarget))) {
            Write-Info "prometheus.yml already in place; skipping copy"
        } else {
            Copy-Item $promSource $promTarget -ErrorAction SilentlyContinue
            if (Test-Path $promTarget) {
                Write-Success "Created prometheus.yml"
            }
        }
    }
} else {
    Write-Warn "Observability config templates not found; skipping config copy"
}
{{/if}}

# ─── Environment Template ────────────────────────────────────────────────────
if (-not (Test-Path ".env") -and (Test-Path ".env.template")) {
    Copy-Item ".env.template" ".env" -ErrorAction SilentlyContinue
    if (Test-Path ".env") {
        Write-Success "Created .env from template"
    }
} elseif (-not (Test-Path ".env")) {
    Write-Warn ".env.template not found; skipping .env creation"
}

# Ensure .env is in .gitignore
$gitignore = if (Test-Path ".gitignore") { Get-Content ".gitignore" } else { @() }
if ($gitignore -notcontains ".env") {
    Add-Content ".gitignore" ".env"
    Write-Success "Added .env to .gitignore"
}

# ─── Validation ──────────────────────────────────────────────────────────────
Write-Info "Running validation checks..."

$validationPassed = $true
if (-not (Test-Command "git")) { Write-Err "git not available"; $validationPassed = $false }
if (-not (Test-Command "node")) { Write-Err "node not available"; $validationPassed = $false }
if (-not (Test-Command "python3") -and -not (Test-Command "python")) { Write-Err "python not available"; $validationPassed = $false }

if ($validationPassed) {
    Write-Success "All validation checks passed"
} else {
    Write-Err "Some validation checks failed"
    exit 1
}

Write-Success "SDLC Pipeline setup complete for {{COMPANY_NAME}}"
```

## Variable Resolution

| Variable | Source |
|----------|--------|
| `COMPANY_NAME` | Onboarding answers → Company |
| `PM_SYSTEM` | Onboarding answers → PM System |
| `SCM_PROVIDER` | Onboarding answers → SCM |
| `DESIGN_TOOL` | Auto-detected or "None" |
| `DEFAULT_WORKSPACE` | True if default workspace structure selected |
| `SUBMODULES` | List of development repositories (name, url) |
| `TICKET_CONNECTOR_SETUP` | PM-system-specific config (no auth) |
| `SCM_CONNECTOR_SETUP` | SCM-specific config (no auth) |
| `PREFLIGHT_CHECKS` | Validate all tools and configs |
